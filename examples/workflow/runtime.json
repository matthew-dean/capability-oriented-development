      "claim": "The consumer follows an owner-only change",
      "command": "node",
      "args": [
        "../probe.mjs",
        "conformance"
      ],
      "cwd": "live"
    },
    {
      "id": "evolution",
      "kind": "evolution",
      "claim": "The consumer follows an owner-only change",
      "command": "node",
      "args": [
        "../probe.mjs",
        "conformance"
      ],
      "cwd": "live"
    }
  ]
