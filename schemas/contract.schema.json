{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contractVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z][a-zA-Z0-9._-]*$"
    },
    "profile": {
      "type": "string",
      "enum": [
        "javascript-library",
        "csharp-library",
        "vue-design-system"
      ]
    },
    "responsibility": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "reuse",
            "configure",
            "compose",
            "extend",
            "create"
          ]
        },
        "need": {
          "type": "string",
          "minLength": 1
        },
        "considered": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "candidate": {
                "type": "string",
                "minLength": 1
              },
              "finding": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "candidate",
              "finding"
            ],
            "additionalProperties": false
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "action",
        "need",
        "considered",
        "rationale"
      ],
      "additionalProperties": false
    },
    "owner": {
      "type": "object",
      "properties": {
        "entrypoint": {
          "type": "string",
          "minLength": 1
        },
        "export": {
          "type": "string",
          "minLength": 1
        },
        "files": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "entrypoint",
        "export"
      ],
      "additionalProperties": false
    },
    "consumers": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "entrypoint": {
            "type": "string",
            "minLength": 1
          },
          "export": {
            "type": "string",
            "minLength": 1
          },
          "files": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "examples": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "alternatives": {
            "type": "object",
            "properties": {
              "wrapper": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "object",
                    "properties": {
                      "replace": {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "from": {
                              "type": "string",
                              "minLength": 1
                            },
                            "to": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "from",
                            "to"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "replace"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "copy": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "object",
                    "properties": {
                      "replace": {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "from": {
                              "type": "string",
                              "minLength": 1
                            },
                            "to": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "from",
                            "to"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "replace"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "unusedImport": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "object",
                    "properties": {
                      "replace": {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "from": {
                              "type": "string",
                              "minLength": 1
                            },
                            "to": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "from",
                            "to"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "replace"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "override": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "object",
                    "properties": {
                      "replace": {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "from": {
                              "type": "string",
                              "minLength": 1
                            },
                            "to": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "from",
                            "to"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "replace"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "additional": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "source": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1
                        },
                        {
                          "type": "object",
                          "properties": {
                            "replace": {
                              "minItems": 1,
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "from": {
                                    "type": "string",
                                    "minLength": 1
                                  },
                                  "to": {
                                    "type": "string"
                                  }
                                },
                                "required": [
                                  "from",
                                  "to"
                                ],
                                "additionalProperties": false
                              }
                            }
                          },
                          "required": [
                            "replace"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    },
                    "followsOwner": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "name",
                    "source",
                    "followsOwner"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "wrapper",
              "copy",
              "unusedImport"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "entrypoint",
          "export",
          "id",
          "alternatives"
        ],
        "additionalProperties": false
      }
    },
    "rules": {
      "type": "object",
      "properties": {
        "owns": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "consumerOwns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allowed": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "extend": {
          "type": "string",
          "minLength": 1
        },
        "forbidden": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "owns",
        "consumerOwns",
        "allowed",
        "extend",
        "forbidden"
      ],
      "additionalProperties": false
    },
    "dependencies": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "repository": {
            "type": "string",
            "minLength": 1
          },
          "contract": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "minLength": 1
                  },
                  "format": {
                    "type": "string",
                    "const": "json"
                  },
                  "pointer": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?:\\/(?:[^~]|~[01])*)+$"
                  }
                },
                "required": [
                  "file",
                  "format",
                  "pointer"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "minLength": 1
                  },
                  "format": {
                    "type": "string",
                    "const": "nuget"
                  },
                  "package": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
                  }
                },
                "required": [
                  "file",
                  "format",
                  "package"
                ],
                "additionalProperties": false
              }
            ]
          },
          "revision": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
              },
              {
                "type": "object",
                "properties": {
                  "format": {
                    "type": "string",
                    "const": "nuget"
                  }
                },
                "required": [
                  "format"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "id",
          "repository",
          "contract",
          "version"
        ],
        "additionalProperties": false
      }
    },
    "requirements": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "checks": {
      "type": "object",
      "properties": {
        "entrypoint": {
          "type": "string",
          "minLength": 1
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "entrypoint",
        "files"
      ],
      "additionalProperties": false
    },
    "mapping": {
      "type": "object",
      "properties": {
        "producers": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "command": {
                "type": "string",
                "minLength": 1
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "cwd": {
                "default": ".",
                "type": "string"
              }
            },
            "required": [
              "command",
              "args"
            ],
            "additionalProperties": false
          }
        },
        "symbols": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalInputs": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "producers"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contractVersion",
    "id",
    "profile",
    "responsibility",
    "decision",
    "owner",
    "consumers",
    "rules",
    "requirements",
    "checks"
  ],
  "additionalProperties": false
}
