{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/cod/capability-v1",
  "title": "COD capability manifest v1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "id", "intent", "owner", "status", "operations"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"},
    "intent": {"type": "string", "pattern": "\\S"},
    "owner": {"type": "string", "pattern": "\\S"},
    "status": {"enum": ["proposed", "experimental", "stable", "deprecated", "retired"]},
    "operations": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false, "required": ["name", "file", "export"],
      "properties": {"name": {"type": "string", "pattern": "\\S"}, "file": {"type": "string", "minLength": 1}, "export": {"type": "string", "pattern": "\\S"}}
    }},
    "requires": {"type": "array", "uniqueItems": true, "default": [], "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"}},
    "extensions": {"$ref": "#/definitions/strings"}, "examples": {"$ref": "#/definitions/strings"},
    "tests": {"$ref": "#/definitions/strings"}, "invariants": {"$ref": "#/definitions/strings"},
    "evolution": {"type": "object", "additionalProperties": false, "required": ["guidance"], "properties": {
      "guidance": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "\\S"}}
    }}
  },
  "definitions": {"strings": {"type": "array", "uniqueItems": true, "default": [], "items": {"type": "string", "pattern": "\\S"}}}
}
